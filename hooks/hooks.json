{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/update_gate.py\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${CLAUDE_PLUGIN_ROOT}/skills/audit/engine\" update check --hook 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
